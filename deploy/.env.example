# =============================================================================
# HoneyRest 단일 서버 배포 환경변수 (deploy/docker-compose.yml 이 읽는다)
#
#   cp .env.example .env && chmod 600 .env
#   setup.sh 는 이 파일을 복사한 뒤 [비밀] 값을 openssl rand 로 생성하고 SITE_DOMAIN 을 자동으로 채운다.
#
# 표기
#   [필수] 비어 있으면 compose 가 시작을 거부하거나 앱이 기동하지 않는다
#   [비밀] 외부에 노출되면 안 되는 값 — .env 는 git 에 올리지 않는다(.gitignore)
#   [선택] 비워 두면 해당 기능만 동작하지 않는다 (기동은 정상)
#   [빌드] 프론트엔드 번들에 빌드 시점에 박히는 값 — 바꾸면 `docker compose build caddy` 후 `up -d` 필요
#
# 값에 공백이나 # 이 들어가면 큰따옴표로 감싼다.
# =============================================================================

# ---- 공개 주소 ---------------------------------------------------------------
# [필수][빌드] 사용자 사이트 호스트 이름 (https:// 없이). 관리자 사이트는 admin.<SITE_DOMAIN>.
#   도메인이 없을 때: 공인 IP 의 점(.)을 하이픈(-)으로 바꾼 sslip.io 이름 → setup.sh 가 자동 감지해 채운다
#   예) 공인 IP 152.70.12.34 → 152-70-12-34.sslip.io / admin.152-70-12-34.sslip.io
#   도메인을 산 뒤: example.com 처럼 바꾸고 DNS A 레코드(@, admin)를 서버 IP 로 지정
SITE_DOMAIN=CHANGE_ME.sslip.io

# [선택] 사용자 API 의 CORS 허용 Origin (쉼표 구분). 비우면 https://<SITE_DOMAIN> 하나.
#   SPA 와 API 가 같은 Origin 이라 보통 비워 둔다.
APP_CORS_ORIGINS=

# ---- MySQL -------------------------------------------------------------------
# [필수] 데이터베이스 / 애플리케이션 계정 이름
MYSQL_DATABASE=honeyrest_db
MYSQL_USER=honeyrest
# [필수][비밀] 애플리케이션 계정 비밀번호 (사용자 API·관리자 앱이 사용)
#   주의: MySQL 볼륨이 처음 만들어질 때만 적용된다. 나중에 바꾸려면 MySQL 안에서 ALTER USER 도 해야 한다.
MYSQL_PASSWORD=
# [필수][비밀] root 비밀번호 (seed.sh / backup.sh 가 컨테이너 안에서만 사용)
MYSQL_ROOT_PASSWORD=
# [선택] InnoDB 버퍼 풀 크기. 6GB 서버 기준 256M, 24GB 로 늘리면 1G 정도까지 올려도 된다.
MYSQL_INNODB_BUFFER_POOL_SIZE=256M

# ---- JWT ---------------------------------------------------------------------
# [필수][비밀] 사용자 API 액세스 토큰 서명 키 (HS256, 32바이트 이상). 바꾸면 기존 로그인은 모두 만료된다.
USER_JWT_SECRET=
# [필수][비밀] 관리자 앱 서명 키 (사용자 API 와 다른 값)
HOST_JWT_SECRET=

# ---- 관리자 데모 계정 ------------------------------------------------------------
# [선택] 관리자 앱 Spring 프로필. prod,local-demo 이면 기동 시 데모 계정을 만든다 (이미 있으면 건드리지 않음).
#   업체 관리자: contact@honeyrest.com 외 5개 (db/seed 의 업체와 같은 이메일) / 총관리자: admin@honeyrest.com
#   데모 계정이 필요 없으면 prod 로 바꾼다.
HOST_SPRING_PROFILES=prod,local-demo
# [선택][비밀] 데모 계정 비밀번호. 비어 있으면 해당 계정을 만들지 않는다 (코드 기본값은 prod 에서 쓰지 않음).
#   처음 생성된 뒤에는 값을 바꿔도 기존 계정 비밀번호는 바뀌지 않는다.
DEMO_COMPANY_PASSWORD=
DEMO_ADMIN_PASSWORD=

# ---- 토스페이먼츠 (결제위젯) --------------------------------------------------------
# [선택][빌드] 위젯 클라이언트 키 (test_gck_... / 공개돼도 되는 키). 프론트 번들에 들어간다.
TOSS_CLIENT_KEY=
# [선택][비밀] 위젯 시크릿 키 (test_gsk_...). 반드시 테스트 키를 쓴다 — 라이브 키는 실제 결제가 일어난다.
#   비어 있으면 결제 승인만 실패한다.
TOSS_SECRET_KEY=

# ---- 메일 (Gmail SMTP) ---------------------------------------------------------
# [선택] 비어 있으면 메일 발송을 생략(no-op)한다.
#   주의: 그러면 회원가입 이메일 인증 메일이 가지 않아 일반 가입자는 로그인할 수 없다 (docs/DEPLOY.md 문제 해결 참고).
MAIL_USERNAME=
# [선택][비밀] Gmail 앱 비밀번호 (구글 계정 2단계 인증 → 앱 비밀번호, 16자리). 계정 비밀번호가 아니다.
MAIL_PASSWORD=

# ---- 소셜 로그인 ----------------------------------------------------------------
# [선택][빌드] 비어 있으면 소셜 로그인만 실패한다.
#   콘솔에 등록할 Redirect URI: https://<SITE_DOMAIN>/login/google/callback, https://<SITE_DOMAIN>/login/kakao/callback
#   (Google 은 sslip.io 같은 공용 접미사 도메인을 승인된 도메인으로 받지 않을 수 있다 → 실제 도메인 권장)
GOOGLE_CLIENT_ID=
# [선택][비밀]
GOOGLE_CLIENT_SECRET=
# [선택][빌드] 카카오 REST API 키
KAKAO_CLIENT_ID=
# [선택][비밀]
KAKAO_CLIENT_SECRET=

# ---- 외부 API -----------------------------------------------------------------
# [선택][비밀] OpenWeather API 키 (날씨 위젯)
WEATHER_API_KEY=
# [선택][빌드] Google Maps JavaScript API 키 / 지도 ID (지도 검색·숙소 위치). HTTP 리퍼러 제한을 걸어 둔다.
GOOGLE_MAPS_API_KEY=
GOOGLE_MAP_ID=
# [선택][빌드] 공공데이터포털 특일(공휴일) API 서비스 키 (달력 공휴일 표시)
HOLIDAY_API_KEY=

# ---- 기타 ---------------------------------------------------------------------
# [선택] 사용자 API Swagger UI 공개 여부 (https://<SITE_DOMAIN>/swagger-ui.html)
SPRINGDOC_ENABLED=false

# ---- 메모리 (6GB 기준 기본값, 24GB 로 늘리면 키워도 된다) -------------------------------------
# 컨테이너 메모리 상한. JVM 힙은 상한의 70% (MaxRAMPercentage=70).
MYSQL_MEM_LIMIT=768m
REDIS_MEM_LIMIT=160m
REDIS_MAXMEMORY=128mb
USER_API_MEM_LIMIT=1g
HOST_ADMIN_MEM_LIMIT=900m
CADDY_MEM_LIMIT=192m
USER_API_JAVA_OPTS="-XX:MaxRAMPercentage=70 -XX:+ExitOnOutOfMemoryError"
HOST_ADMIN_JAVA_OPTS="-XX:MaxRAMPercentage=70 -XX:+ExitOnOutOfMemoryError"

# ---- 저장소 위치 (deploy/ 기준 상대 경로) ------------------------------------------------
# 세 저장소를 /opt/honeyrest 아래에 나란히 클론했다면 그대로 둔다.
HOST_REPO_DIR=../../honeyRest_host
REACT_REPO_DIR=../../honeyrest_user_react
